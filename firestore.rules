rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // The update only adds the caller to `field`, and changes nothing else.
    function onlyAddsSelf(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field].hasAll(resource.data[field])
        && request.resource.data[field].size() == resource.data[field].size() + 1
        && me() in request.resource.data[field];
    }
    // The update only removes the caller from `field`.
    function onlyRemovesSelf(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && resource.data[field].hasAll(request.resource.data[field])
        && request.resource.data[field].size() == resource.data[field].size() - 1
        && !(me() in request.resource.data[field]);
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── Users: public name/email, private settings & exams ──
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
      match /{sub=**} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // ── Roadmaps ──
    match /roadmaps/{rid} {
      function roadmapMember() {
        return signedIn() && me() in get(/databases/$(database)/documents/roadmaps/$(rid)).data.memberIds;
      }
      allow read: if signedIn() && me() in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()];
      allow update: if signedIn() && (
        (resource.data.ownerId == me() && request.resource.data.ownerId == me())
        || onlyAddsSelf('memberIds')
      );
      allow delete: if signedIn() && resource.data.ownerId == me();

      match /progress/{uid} {
        allow read: if roadmapMember();
        allow write: if roadmapMember() && me() == uid;
      }
      match /items/{itemId} {
        allow read: if roadmapMember();
        allow create: if roadmapMember() && request.resource.data.authorId == me();
        allow update, delete: if roadmapMember() && resource.data.authorId == me();
      }
    }

    // ── Circles ──
    match /circles/{cid} {
      function isAdminOf(data) {
        return me() == data.ownerId || me() in data.get('adminIds', []);
      }
      function circleData() {
        return get(/databases/$(database)/documents/circles/$(cid)).data;
      }
      function circleMember() { return signedIn() && me() in circleData().memberIds; }
      function circleAdmin() { return signedIn() && isAdminOf(circleData()); }
      // Classroom: only admins organise. Squad: every member can.
      function canOrganize() {
        return circleAdmin() || circleData().get('type', 'squad') != 'classroom';
      }

      allow read: if signedIn() && me() in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()];
      allow update: if signedIn() && (
        // join with invite code (unless removed by an admin)
        (onlyAddsSelf('memberIds') && !(me() in resource.data.get('bannedIds', [])))
        // leave (the owner can't leave, only delete)
        || (onlyRemovesSelf('memberIds') && me() != resource.data.ownerId)
        // chat preview
        || (me() in resource.data.memberIds && onlyChanges(['lastMessage', 'lastAt']))
        // owner manages everything (but stays owner and member)
        || (me() == resource.data.ownerId
            && request.resource.data.ownerId == resource.data.ownerId
            && resource.data.ownerId in request.resource.data.memberIds)
        // other admins: add/remove students, rename, change type — never touch admins
        || (isAdminOf(resource.data)
            && onlyChanges(['memberIds', 'bannedIds', 'name', 'type'])
            && resource.data.ownerId in request.resource.data.memberIds
            && resource.data.get('adminIds', []).toSet().intersection(
                 resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet())
               ).size() == 0)
      );
      allow delete: if signedIn() && resource.data.ownerId == me();

      match /messages/{mid} {
        allow read: if circleMember();
        allow create: if circleMember() && request.resource.data.senderId == me()
          && (!(request.resource.data.type in ['poll', 'session']) || canOrganize());
        allow update: if circleMember() && (
          (onlyChanges(['votes'])
            && request.resource.data.votes.diff(resource.data.get('votes', {})).affectedKeys().hasOnly([me()]))
          || (resource.data.senderId == me() && resource.data.type == 'text' && onlyChanges(['text', 'editedAt']))
          || ((resource.data.senderId == me() || circleAdmin()) && resource.data.type == 'session'
              && onlyChanges(['text', 'startsAt', 'durationMin', 'editedAt']))
        );
        allow delete: if circleMember() && (resource.data.senderId == me() || circleAdmin());
      }
      match /sessions/{sid} {
        allow read: if circleMember();
        allow create: if circleMember() && request.resource.data.createdBy == me() && canOrganize();
        allow update, delete: if circleMember() && (resource.data.createdBy == me() || circleAdmin());
      }
    }

    // ── Invite codes: look up by exact code only (no listing) ──
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == me();
    }
  }
}
